{
  "manifest_version": 3,
  "name": "Viewport Search",
  "version": "1.0.2",
  "description": "Find a word on the page and jump from one viewport of matches to the next.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Viewport Search",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting"],
  "commands": {
    "next-viewport": {
      "suggested_key": { "default": "Alt+Shift+N" },
      "description": "Jump to the next viewport of matches"
    },
    "prev-viewport": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Jump to the previous viewport of matches"
    },
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Open the search popup"
    }
  }
}
